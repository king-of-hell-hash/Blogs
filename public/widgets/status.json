{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "SEO Blog Studio",
      "weight": "Bolder",
      "size": "Medium",
      "color": "Accent"
    },
    {
      "type": "TextBlock",
      "text": "${statusMessage}",
      "wrap": true,
      "size": "Small"
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "Topic:",
          "value": "${lastTopic}"
        },
        {
          "title": "SEO Score:",
          "value": "${seoScore}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open Blog Studio",
      "url": "https://blogs-kappa-bice.vercel.app/"
    }
  ]
}
