{
  "id": "/",
  "name": "SEO Blog Studio",
  "short_name": "Blog Studio",
  "description": "Online Web Research & AI Visuals Engine for generating SEO-optimized blog content with images",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "tabbed_display",
    "tabbed-display",
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#7c3aed",
  "iarc_rating_id": "",
  "related_applications": [],
  "prefer_related_applications": false,
  "scope_extensions": [],
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/",
      "name": "Markdown and Text Drafts",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ],
      "accept": {
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+blogstudio",
      "url": "/?topic=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "widgets": [
    {
      "name": "Recent Post Status",
      "short_name": "Post Status",
      "description": "Check status of recent AI blog generation",
      "tag": "blog-status",
      "template": "widget-template",
      "ms_ac_template": "widgets/status.json",
      "data": "widgets/status-data.json",
      "type": "application/json",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 86400
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-1280x720.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "SEO Blog Studio Desktop Dashboard"
    },
    {
      "src": "/screenshots/mobile-750x1334.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "SEO Blog Studio Mobile Interface"
    }
  ],
  "shortcuts": [
    {
      "name": "Generate New Post",
      "short_name": "New Post",
      "description": "Research and generate a new SEO blog post with AI",
      "url": "/?action=new",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Visual Studio",
      "short_name": "Images",
      "description": "Browse and edit blog visual topic galleries",
      "url": "/?tab=images",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
