      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Visual Studio",
      "short_name": "Images",
      "description": "Browse and edit blog visual topic galleries",
      "url": "/?tab=images",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
